config {
  type: "table",
  schema: dataform.projectConfig.vars.ds_prefix + "core",
  name: "fct_conversions",
  tags: ["core", "daily"],
  bigquery: { partitionBy: "conversion_date", clusterBy: ["conv_type"] }
}

js { const ga4 = require("includes/ga4.js"); }

SELECT
  e.event_id                                 AS conversion_id,

  -- Use the session's identity, not the single event's. Otherwise a
  -- conversion can carry a different identity_key than its own session and
  -- drops out of the join in bridge_attribution.
  COALESCE(s.identity_key, e.identity_key)   AS identity_key,

  e.session_key,
  e.event_ts                                 AS conversion_ts,
  e.event_date                               AS conversion_date,
  e.event_name                               AS conv_type,
  CASE WHEN e.event_name IN (${ga4.CONV})  THEN 'macro'
       WHEN e.event_name IN (${ga4.MICRO}) THEN 'micro' END AS conv_class,
  IFNULL(e.event_value, 1.0)                 AS conv_value,
  -- Flags when conv_value is only the default rather than a real value.
  e.event_value IS NULL                      AS conv_value_imputed
FROM ${ref("events")} e
LEFT JOIN ${ref("fct_sessions")} s
  ON s.session_key = e.session_key
WHERE e.event_name IN (${ga4.CONV}, ${ga4.MICRO})
  AND e.session_key IS NOT NULL